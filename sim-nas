#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    init|check|start|stop|restart|status|logs)
        exec "$ROOT_DIR/scripts/$COMMAND.sh" "$@"
        ;;
    help|-h|--help)
        cat <<'HELP'
sim-nas - minimal Docker-based SMB NAS

Usage:
  ./sim-nas init
  ./sim-nas check
  ./sim-nas start
  ./sim-nas stop
  ./sim-nas restart
  ./sim-nas status
  ./sim-nas logs
HELP
        ;;
    *)
        echo "Unknown command: $COMMAND" >&2
        echo "Run './sim-nas help' for usage." >&2
        exit 2
        ;;
esac
