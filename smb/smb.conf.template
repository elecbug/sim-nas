[global]
    server role = standalone server
    security = user
    map to guest = never

    server min protocol = SMB2
    server max protocol = SMB3
    smb ports = 445

    load printers = no
    printing = bsd
    printcap name = /dev/null
    disable spoolss = yes

    log file = /var/log/samba/log.%m
    max log size = 1000
    logging = file

    passdb backend = tdbsam

[${SMB_SHARE}]
    path = /nas/storage
    browseable = yes
    read only = no
    guest ok = no
    valid users = ${SMB_USER}
    force user = ${SMB_USER}
    create mask = 0660
    directory mask = 0770
