# sim-nas configuration

# SMB account and share name
SMB_USER=nas
SMB_SHARE=storage

# Host directory exported through SMB
HOST_STORAGE_PATH=/mnt/nas

# Linux ownership used by the Samba account inside the container
PUID=1000
PGID=1000

# Published SMB port
SMB_PORT=445

# Refuse to start unless HOST_STORAGE_PATH is an actual mount point.
# Set to false only when intentionally sharing a directory on the root filesystem.
REQUIRE_MOUNT=true
